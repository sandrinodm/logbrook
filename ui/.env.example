# Copy to .env for `pnpm dev`. The dev server reads .env; the built server (`pnpm start`) does not,
# so there export these variables or pass them to the container. Empty values count as not set.
#
# The app has no authentication of its own. Everyone who can reach it gets the access of the tokens
# below. Keep it on loopback or put it behind an authenticating reverse proxy.

# Base URL of the Logbrook server the BFF proxies to. Defaults to http://127.0.0.1:3100.
LOGBROOK_URL=http://127.0.0.1:3100

# Required. A Logbrook read token (16 to 512 visible ASCII characters, no whitespace). The server
# refuses to start without it. `pnpm dev:logbrook` prints one for a throwaway server.
LOGBROOK_READ_TOKEN=

# Optional. A Logbrook admin token, different from the read token. Without it, creating and deleting
# indexes is unavailable. With it, everyone who can reach the app can do both.
LOGBROOK_ADMIN_TOKEN=

# Optional. Address the built server (`pnpm start`) listens on. Defaults to 127.0.0.1, so only this
# machine can reach it. Set it to 0.0.0.0 to listen on all interfaces, for example in a container
# (the Dockerfile does), and then publish the port on loopback only or put an authenticating
# reverse proxy in front. `pnpm dev` ignores it.
# HOST=127.0.0.1

# Optional. Host names the server answers to, comma-separated, ports ignored. Any other Host header
# gets 421, which stops DNS rebinding: a malicious site whose name resolves to this machine cannot
# talk to an unauthenticated app that listens on loopback. When unset and the server listens on
# loopback, only localhost, 127.0.0.1 and [::1] are accepted. When unset and it listens elsewhere,
# every host is accepted and the boot log warns about it. localhost, 127.0.0.1 and [::1] are always
# accepted. Set it to the public host name behind a reverse proxy, e.g. logs.example.com.
# ALLOWED_HOSTS=
