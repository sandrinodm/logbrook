# Use the same ingestion token configured on the running Logbrook server.
LOGBROOK_URL=http://127.0.0.1:3100
LOGBROOK_INDEX=pino-demo
LOGBROOK_INGEST_TOKEN=
LOG_SERVICE=checkout

# Counts, not bytes. Keep batches below your server's body and event limits.
BATCH_SIZE=250
BATCH_INTERVAL_MS=1000
MAX_BUFFER_SIZE=10000
HTTP_TIMEOUT_MS=1500
MAX_RETRIES=2
RETRY_DELAY_MS=250

# npm run bulk: a finite run, paced in chunks of at most 100 records.
LOG_COUNT=10000
LOG_RATE=1000
# Optional unique marker; otherwise a UUID is generated for each run.
# RUN_ID=load-001
