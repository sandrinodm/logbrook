# Baseline from Docker's generated-project example:
# https://docs.docker.com/guides/python/#create-a-dockerfile
**/.DS_Store
**/__pycache__
**/.venv
**/.classpath
**/.dockerignore
**/.env
**/.git
**/.gitignore
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/bin
**/charts
**/docker-compose*
**/compose.y*ml
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
LICENSE
README.md

# Logbrook ships its license in the runtime image.
!LICENSE

# Rust build output and local profiling data.
**/target
**/*.rs.bk
**/*.profraw
**/*.profdata

# Local credentials, configuration, stored logs, and generated measurements.
**/.env*
**/*.local.toml
/data
/artifacts

# Editor files.
**/.idea
**/*.swp
**/*.swo
**/*~

# Documentation, examples, and development tools are not build inputs.
/.github
/docs
/examples
/tests
/xtask/src
/xtask/tests
/licenses
/*.md
/.editorconfig
/logbrook.example.toml
